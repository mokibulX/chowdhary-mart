NODE_ENV=development
PORT=5000

# Primary PostgreSQL fallback / local development
DATABASE_URL=
DATABASE_DIRECT_URL=
DIRECT_URL=
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_SSL=true
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=10000

# Auth/User DB: customer, seller, rider, admin identity and sessions
AUTH_DATABASE_URL=
AUTH_DATABASE_DIRECT_URL=
AUTH_DATABASE_HOST=
AUTH_DATABASE_PORT=5432
AUTH_DATABASE_NAME=
AUTH_DATABASE_USER=
AUTH_DATABASE_PASSWORD=
AUTH_DATABASE_SSL=true
AUTH_DATABASE_POOL_MAX=10

# Marketplace/Product DB: stores, categories, products, banners, coupons
MARKETPLACE_DATABASE_URL=
MARKETPLACE_DATABASE_DIRECT_URL=
MARKETPLACE_DATABASE_HOST=
MARKETPLACE_DATABASE_PORT=5432
MARKETPLACE_DATABASE_NAME=
MARKETPLACE_DATABASE_USER=
MARKETPLACE_DATABASE_PASSWORD=
MARKETPLACE_DATABASE_SSL=true
MARKETPLACE_DATABASE_POOL_MAX=10

# Order/Payment/Invoice DB
ORDER_DATABASE_URL=
ORDER_DATABASE_DIRECT_URL=
ORDER_DATABASE_HOST=
ORDER_DATABASE_PORT=5432
ORDER_DATABASE_NAME=
ORDER_DATABASE_USER=
ORDER_DATABASE_PASSWORD=
ORDER_DATABASE_SSL=true
ORDER_DATABASE_POOL_MAX=10

# Delivery DB: live rider state, route snapshots, proof of delivery
DELIVERY_DATABASE_URL=
DELIVERY_DATABASE_DIRECT_URL=
DELIVERY_DATABASE_HOST=
DELIVERY_DATABASE_PORT=5432
DELIVERY_DATABASE_NAME=
DELIVERY_DATABASE_USER=
DELIVERY_DATABASE_PASSWORD=
DELIVERY_DATABASE_SSL=true
DELIVERY_DATABASE_POOL_MAX=10

# Analytics/Audit DB: event stream, admin actions, audit logs
ANALYTICS_DATABASE_URL=
ANALYTICS_DATABASE_DIRECT_URL=
ANALYTICS_DATABASE_HOST=
ANALYTICS_DATABASE_PORT=5432
ANALYTICS_DATABASE_NAME=
ANALYTICS_DATABASE_USER=
ANALYTICS_DATABASE_PASSWORD=
ANALYTICS_DATABASE_SSL=true
ANALYTICS_DATABASE_POOL_MAX=5

# Redis cache / queue
REDIS_URL=
REDIS_QUEUE_PREFIX=chowdharymart
REDIS_CACHE_TTL_SECONDS=300

# Optional document/event provider
MONGODB_URI=

# Auth/session
JWT_ACCESS_SECRET=
JWT_SECRET=
JWT_REFRESH_SECRET=
SESSION_SECRET=

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Object storage
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_PUBLIC_BASE_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_CDN_URL=

# Maps and routing
MAPS_API_KEY=
ROUTES_API_KEY=
GEOCODING_API_KEY=

# Notifications
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
WEBSOCKET_URL=

# Razorpay Payment Gateway
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PAYMENT_CAPTURE=true
RAZORPAY_CURRENCY=INR

# RazorpayX Payouts
RAZORPAYX_ENABLED=false
RAZORPAYX_MODE=test
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=
RAZORPAYX_WEBHOOK_SECRET=
RAZORPAYX_DEFAULT_CURRENCY=INR
RAZORPAYX_MIN_WITHDRAWAL_AMOUNT=100
RAZORPAYX_REQUIRE_ADMIN_APPROVAL=true
RAZORPAYX_PAYOUT_PURPOSE=payout

# Wallet
CUSTOMER_WALLET_ENABLED=true
CUSTOMER_WALLET_WITHDRAWAL_ENABLED=false
CUSTOMER_WALLET_PARTIAL_PAYMENT_ENABLED=true
SELLER_WALLET_ENABLED=true
RIDER_WALLET_ENABLED=true

# Rider Licence Rules
REQUIRE_DRIVING_LICENCE_FOR_BICYCLE=false
REQUIRE_DRIVING_LICENCE_FOR_E_BICYCLE=false
REQUIRE_DRIVING_LICENCE_FOR_MOTORBIKE=true
REQUIRE_DRIVING_LICENCE_FOR_SCOOTER=true
VITE_REQUIRE_DRIVING_LICENCE_FOR_BICYCLE=false
VITE_REQUIRE_DRIVING_LICENCE_FOR_E_BICYCLE=false
VITE_REQUIRE_DRIVING_LICENCE_FOR_MOTORBIKE=true
VITE_REQUIRE_DRIVING_LICENCE_FOR_SCOOTER=true
VITE_RAZORPAY_KEY_ID=
VITE_API_URL=

# Demo accounts must stay disabled unless explicitly needed in development.
ENABLE_DEMO_ACCOUNTS=false
VITE_ENABLE_DEMO_ACCOUNTS=false
