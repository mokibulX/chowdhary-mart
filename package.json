{
  "name": "workspace",
  "version": "0.0.0",
  "private": true,
  "description": "",
  "license": "MIT",
  "author": "",
  "type": "commonjs",
  "packageManager": "pnpm@11.9.0",
  "main": "index.js",
  "directories": {
    "lib": "lib"
  },
  "scripts": {
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "start": "node scripts/start-render.mjs",
    "render:build": "pnpm --filter @workspace/api-server run build",
    "render:web:build": "pnpm --filter @workspace/web run build",
    "dev": "pnpm run cmart",
    "cmart": "powershell -ExecutionPolicy Bypass -File ./run-app.ps1",
    "cmart:api": "powershell -ExecutionPolicy Bypass -File ./run-server.ps1",
    "cmart:web": "powershell -ExecutionPolicy Bypass -File ./run-web.ps1",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "android:sync": "pnpm --filter @workspace/web run android:sync",
    "android:open": "pnpm --filter @workspace/web run android:open",
    "android:debug": "pnpm --filter @workspace/web run android:debug",
    "android:release": "pnpm --filter @workspace/web run android:release"
  },
  "devDependencies": {
    "@esbuild/win32-x64": "^0.27.3",
    "@rollup/rollup-win32-x64-msvc": "^4.62.0",
    "@tailwindcss/oxide-win32-x64-msvc": "4.3.0",
    "lightningcss-win32-x64-msvc": "1.32.0",
    "prettier": "^3.8.3",
    "typescript": "~5.9.3"
  }
}
